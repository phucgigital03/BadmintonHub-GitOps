# Mẫu cho .env local (đã gitignore) — CHỈ dùng cho kind ở Day 2.
# staging/prod KHÔNG dùng file này: giá trị nằm ở SSM /badminton/<env>/*, Git chỉ ref tên param.
# Copy thành .env rồi điền. TUYỆT ĐỐI không commit .env.
#
# ⚠️ Key phải TỒN TẠI kể cả khi để rỗng: SENDGRID_API_KEY và CLOUDINARY_* không có default
# trong application.yml (SendGrid) hoặc bị Guard kiểm tra (Cloudinary, chỉ ở profile prod).
# Thiếu hẳn key = Spring không resolve được placeholder = fail context.

# --- App secrets (namespace dev) ---
JWT_SECRET=            # bắt buộc, KHÔNG được rỗng: openssl rand -hex 64
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=

# Dùng chung POSTGRES_PASSWORD cho cả 5 DB — app chỉ có một cặp user/pass.
# Phải khớp password mà chart Bitnami PostgreSQL boot lên (cùng nguồn: xem datastore bên dưới).

# ?authSource=admin là BẮT BUỘC: root user của Mongo nằm ở db `admin`, không phải chat_db.
MONGODB_CHAT_URI=mongodb://root:CHANGE_ME@mongodb.data-dev.svc.cluster.local:27017/chat_db?authSource=admin

RABBITMQ_PASS=

# Để rỗng cũng chạy được trên kind (dev không bật profile prod):
#   SendGrid rỗng  → EmailServiceImpl log link verify ra console thay vì gửi mail
#   Cloudinary rỗng → CloudinaryService trả URL local-fallback://
SENDGRID_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public client ID, không phải secret. Đường login của demo là email/password nên để rỗng vẫn ổn.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Datastore secrets (namespace data-dev) ---
# scripts/kind-secret.sh lấy giá trị ở trên để sinh luôn Secret cho datastore, nên password
# mà Postgres/Mongo/RabbitMQ boot lên và password mà app dùng luôn là MỘT.
# Riêng erlang cookie thì datastore tự dùng, app không đụng tới.
RABBITMQ_ERLANG_COOKIE=
